{
  "name": "ap-pw-template-ts",
  "version": "1.0.0",
  "description": "Playwright SDET Framework with clean architecture",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:client": "playwright test --project='client chromium'",
    "test:api": "playwright test --project='api tests'",
    "report": "playwright show-report",
    "report:allure": "allure serve allure-results",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\""
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "automation",
    "framework"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.0",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.0",
    "zod": "^3.22.0"
  }
}
