# Development Environment Configuration

# Base URLs
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Environment
ENV=dev

# Timeouts (milliseconds)
ACTION_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
TEST_TIMEOUT=120000

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Credentials - Development
CLIENT_USER_EMAIL=client.dev@example.com
CLIENT_USER_PASSWORD=DevPassword@123

ADMIN_USER_EMAIL=admin.dev@example.com
ADMIN_USER_PASSWORD=AdminDev@123

# Logging
LOG_LEVEL=debug

# Feature Flags
ENABLE_VIDEO_RECORDING=false
ENABLE_SCREENSHOTS=true
