# Production Environment Configuration

# Base URLs
BASE_URL=https://example.com
API_URL=https://api.example.com

# Environment
ENV=prod

# Timeouts (milliseconds)
ACTION_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
TEST_TIMEOUT=120000

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=2000

# Credentials - Production
CLIENT_USER_EMAIL=client.prod@example.com
CLIENT_USER_PASSWORD=ProdPassword@123

ADMIN_USER_EMAIL=admin.prod@example.com
ADMIN_USER_PASSWORD=AdminProd@123

# Logging
LOG_LEVEL=warn

# Feature Flags
ENABLE_VIDEO_RECORDING=true
ENABLE_SCREENSHOTS=true
