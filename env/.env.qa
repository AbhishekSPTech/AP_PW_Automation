# QA Environment Configuration

# Base URLs
BASE_URL=https://opensource-demo.orangehrmlive.com/
API_URL=https://api.qa.example.com

# Environment
ENV=qa

# Timeouts (milliseconds)
ACTION_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
TEST_TIMEOUT=120000

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Credentials - QA
CLIENT_USER_EMAIL=client.qa@example.com
CLIENT_USER_NAME=Client
CLIENT_USER_PASSWORD=QaPassword@123

ADMIN_USER_EMAIL=admin.qa@example.com
ADMIN_USER_NAME=Admin
ADMIN_USER_PASSWORD=admin123

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_VIDEO_RECORDING=true
ENABLE_SCREENSHOTS=true
