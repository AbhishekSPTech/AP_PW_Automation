# QA Environment Configuration

# Base URLs
BASE_URL=https://opensource-demo.orangehrmlive.com
API_URL=https://opensource-demo.orangehrmlive.com/web/index.php/api/v2

# App Routes
LOGIN_PATH=/web/index.php/auth/login
POST_LOGIN_URL_PATTERN=**/dashboard/index
EMPLOYEE_PROFILE_PATH=/web/index.php/pim/viewPersonalDetails/empNumber/{empNumber}

# Environment
ENV=qa

# Timeouts (milliseconds)
ACTION_TIMEOUT=30000
NAVIGATION_TIMEOUT=60000
TEST_TIMEOUT=120000

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# Credentials - QA
CLIENT_USER_EMAIL=client.qa@example.com
CLIENT_USER_USERNAME=Client
CLIENT_USER_PASSWORD=QaPassword@123

ADMIN_USER_EMAIL=admin.qa@example.com
ADMIN_USER_USERNAME=Admin
ADMIN_USER_PASSWORD=admin123

# Self-Healing Locators
# Provider: claude | openai | none (none = local label/role matching only)
# API keys go in env/.env.local (gitignored) or your shell: ANTHROPIC_API_KEY / OPENAI_API_KEY
HEALING_ENABLED=true
HEALING_PROVIDER=claude
HEALING_PROBE_TIMEOUT=10000
HEALING_MIN_CONFIDENCE=0.7

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_VIDEO_RECORDING=true
ENABLE_SCREENSHOTS=true
